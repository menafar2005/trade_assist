{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-journal",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build:worker" },

  // React build, served by Workers Assets; only /api/* runs the Go Worker.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-journal",
      "database_id": "aadb4a1b-e78c-4e2b-944c-874ba35041bd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "trade-journal-images" }]

  // Secrets (not stored here): APP_PASSWORD, SESSION_SECRET
  //   npx wrangler secret put APP_PASSWORD
  //   npx wrangler secret put SESSION_SECRET
}
